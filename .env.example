# Keep real credentials only on your server.
SUMM_DOMAIN=booksumm.duckdns.org
# Encrypts each user's Gemini key at rest. Back it up with the summ_data volume; if it changes, users re-enter their keys.
SUMM_SECRET_KEY=replace-with-a-long-random-secret
SUMM_ALLOWED_ORIGINS=https://booksumm.duckdns.org
SUMM_ALLOW_SIGNUP=true
# The app is only reachable through Caddy, so trust the client address Caddy forwards.
SUMM_TRUST_PROXY=true
# OAuth web client ID. Add the site's HTTPS origin under Authorized JavaScript origins in Google Auth Platform.
GOOGLE_CLIENT_ID=
# Server-side key restricted to the Books API in Google Cloud.
GOOGLE_BOOKS_API_KEY=
# The owner: the Google-verified account with this email can import, summarize, publish, and approve editors.
# Username and password accounts can never be the owner. Everyone else can only read published summaries.
SUMM_OWNER_EMAIL=
# Optional: book reviews from The Guardian (free developer key: https://open-platform.theguardian.com/access/)
GUARDIAN_API_KEY=
# Optional: New York Times book reviews (free key: https://developer.nytimes.com/ → enable the Books API)
NYT_API_KEY=
